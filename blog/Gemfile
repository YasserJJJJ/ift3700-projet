# frozen_string_literal: true

source "https://rubygems.org"

gem "jekyll", "~> 4.4"

# Needed for `jekyll serve` on Ruby >= 3.0
gem "webrick", "~> 1.8"

group :jekyll_plugins do
  gem "jekyll-paginate"
end

# Windows does not ship zoneinfo files
platforms :windows, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end

